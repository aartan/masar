# Desktop / local development configuration.
#
# The desktop always uses a local SQLite file. The Premium Sync API has its own
# PostgreSQL configuration in masar-sync-api/.env.example.

# Local SQLite database used by the Vite/Electron development server.
DATABASE_URL="file:./data/app.db"

# Optional: development-only Premium Sync API address. Packaged builds use the
# address baked in by desktop:prepare and ignore this value at launch.
# MASAR_API_URL="http://127.0.0.1:8787"

# Optional: development only. On Linux systems without a keyring, allow the
# API bearer token to be stored with Electron's plain-text backend (file mode
# 0600). Leave unset in normal installations.
# MASAR_ALLOW_PLAINTEXT_TOKEN="1"
