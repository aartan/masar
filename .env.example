# ── Database ────────────────────────────────────────────────────────────────
# Local development uses a persistent SQLite file via libSQL. This is the
# default when DATABASE_URL is unset, so you can run `npm run dev` right away.
# DATABASE_URL="file:./data/app.db"

# Production on Vercel MUST point at a hosted Turso/libSQL database.
# Create one with: `turso db create kanso` then `turso db show kanso --url`
# DATABASE_URL="libsql://kanso-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Conventional Turso aliases are also supported:
# TURSO_DATABASE_URL="libsql://kanso-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Optional: allow a file: SQLite database in a non-Vercel production runtime
# (e.g. a VPS with a persistent volume). Never enable this on Vercel.
# ALLOW_LOCAL_DB_IN_PRODUCTION="true"
