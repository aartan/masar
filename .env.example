# ── Database ────────────────────────────────────────────────────────────────
# Local development uses a persistent SQLite file via libSQL. This is the
# default when DATABASE_URL is unset, so you can run `npm run dev` right away.
# DATABASE_URL="file:./data/app.db"

# Production on Vercel MUST point at a hosted Turso/libSQL database.
# Create one with: `turso db create masar` then `turso db show masar --url`
# DATABASE_URL="libsql://masar-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Conventional Turso aliases are also supported:
# TURSO_DATABASE_URL="libsql://masar-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Optional: allow a file: SQLite database in a non-Vercel production runtime
# (e.g. a VPS with a persistent volume). Never enable this on Vercel.
# ALLOW_LOCAL_DB_IN_PRODUCTION="true"

# ── Authentication ──────────────────────────────────────────────────────────
# Better Auth signs session cookies with this secret. Required in production;
# generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin used for auth callbacks and trusted origins. Set this to your
# deployed URL in production (for example https://masar.example.com).
# BETTER_AUTH_URL="http://localhost:3000"

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Online accounts require a Stripe subscription or trial. Create a recurring
# price in the Stripe Dashboard, then fill in all four values below. Desktop
# local mode (MASAR_LOCAL_MODE=1) never reads these.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."  # from `stripe listen` or the Dashboard
# STRIPE_PRICE_ID="price_..."        # one recurring monthly/yearly price
# Free-trial length in days. Defaults to 14. Set 0 to charge immediately.
# STRIPE_TRIAL_DAYS="14"
